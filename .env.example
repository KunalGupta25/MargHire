# Copy this file to .env and fill in your values.
# Never commit .env to the repository.

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite is the default. Docker Compose stores it in the named marghire_data volume.
# For local development, use a path in the ignored data directory:
DATABASE_URL=file:./data/marghire.db

# ── API ──────────────────────────────────────────────────────────────────────
# Key used to encrypt provider API keys at rest. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Bind address for the API server (localhost by default; do not change
# unless you have read the security checklist and added authentication).
API_HOST=127.0.0.1
API_PORT=3000

# ── Evaluation harness ───────────────────────────────────────────────────────
# Optional: path to a directory containing your private eval pairs
# (outside the repo). Synthetic pairs in python/eval/data/pairs/ are
# always loaded alongside these.
# EVAL_PRIVATE_PAIRS_DIR=/path/to/your/private/pairs

# ── Cloudflare Workers AI (for Clef / Clef-flash comparison) ────────────────
# 1. Account ID: Cloudflare Dashboard -> "Workers & Pages" (right-hand sidebar)
# 2. API Token: Cloudflare Dashboard -> My Profile -> API Tokens -> Create Custom Token
#    Permissions: Account -> Workers AI -> Read
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Gemini API (for LLM comparison) ──────────────────────────────────────────
# Get your free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
