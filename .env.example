# Copy this file to .env and fill in your values.
# Never commit .env to the repository.

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres (default when running docker compose up):
DATABASE_URL=postgres://marghire:marghire@localhost:5432/marghire

# SQLite fallback (no docker required; remove the Postgres line above):
# DATABASE_URL=file:./data/marghire.db

# ── API ──────────────────────────────────────────────────────────────────────
# Key used to encrypt provider API keys at rest. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Bind address for the API server (localhost by default; do not change
# unless you have read the security checklist and added authentication).
API_HOST=127.0.0.1
API_PORT=3000

# ── Evaluation harness ───────────────────────────────────────────────────────
# Optional: path to a directory containing your private eval pairs
# (outside the repo). Synthetic pairs in python/eval/data/pairs/ are
# always loaded alongside these.
# EVAL_PRIVATE_PAIRS_DIR=/path/to/your/private/pairs
