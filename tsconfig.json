{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true
  },
  "files": [],
  "references": [
    { "path": "./apps/api" },
    { "path": "./apps/web" },
    { "path": "./apps/mcp" },
    { "path": "./packages/core" },
    { "path": "./packages/providers" },
    { "path": "./packages/sources" },
    { "path": "./packages/db" }
  ],
  "exclude": [
    "node_modules",
    "dist",
    "graphify-out",
    "python"
  ]
}
